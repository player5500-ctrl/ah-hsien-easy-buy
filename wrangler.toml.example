name = "ah-hsien-easy-buy-line"
main = "worker/src/entry.mjs"
compatibility_date = "2026-07-18"

[[d1_databases]]
binding = "DB"
database_name = "ah-hsien-easy-buy"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

# 商品圖片儲存（R2）。先建 bucket：npx wrangler r2 bucket create ah-hsien-easy-buy-images
[[r2_buckets]]
binding = "IMAGES"
bucket_name = "ah-hsien-easy-buy-images"

# Secret values must be configured with:
# npx wrangler secret put LINE_CHANNEL_SECRET
# npx wrangler secret put LINE_CHANNEL_ACCESS_TOKEN
# npx wrangler secret put ADMIN_API_KEY

# 非敏感環境設定可放在 [vars]；也可在 Cloudflare Dashboard 設定。
[vars]
LINE_DEFAULT_GROUP_ID = ""
APP_BASE_URL = "https://player5500-ctrl.github.io/ah-hsien-easy-buy/"
